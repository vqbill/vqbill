rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'toannq06034@gmail.com';
    }

    function isAdmin() {
      return isVerified() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSharedWorkspace(ownerId) {
      return ownerId is string && ownerId in ['vqbill_shared_workspace', 'vqbill_default_workspace'];
    }

    function canReadWorkspace(ownerId) {
      return isSharedWorkspace(ownerId) || (isSignedIn() && (request.auth.uid == ownerId || isAdmin()));
    }

    function canWriteWorkspace(ownerId) {
      return isSharedWorkspace(ownerId) || (isVerified() && (request.auth.uid == ownerId || isAdmin()));
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role in ['admin', 'manager', 'cashier', 'viewer', 'inventory'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'ownerId', 'username', 'password', 'displayName',
          'info', 'role', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'username', 'password', 'displayName',
          'info', 'role', 'active', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.password is string && data.password.size() >= 1 && data.password.size() <= 100 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.info is string && data.info.size() <= 500 &&
        data.role is string && data.role in ['admin', 'manager', 'cashier', 'viewer', 'inventory'] &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'ownerId', 'productName', 'category', 'unitPrice', 'unit',
          'totalSold', 'totalReturned', 'totalRevenue', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'productName', 'category', 'unitPrice', 'unit',
          'totalSold', 'totalReturned', 'totalRevenue', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 40 &&
        data.totalSold is number && data.totalSold >= 0 &&
        data.totalReturned is number && data.totalReturned >= 0 &&
        data.totalRevenue is number &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBill(data) {
      return data.keys().hasAll([
          'ownerId', 'billCode', 'billDate', 'paymentType', 'debtorName',
          'debtStatus', 'totalAmount', 'deductedAmount', 'itemsSummary',
          'note', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'billCode', 'billDate', 'rawDate', 'checkInTime', 'checkOutTime',
          'paymentType', 'debtorName', 'debtStatus', 'settleDate', 'settledMethod',
          'paidCashAmount', 'paidTransferAmount', 'subtotalAmount', 'discountAmount',
          'totalAmount', 'deductedAmount', 'itemsSummary',
          'note', 'status', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billCode is string && data.billCode.size() >= 1 && data.billCode.size() <= 64 &&
        data.billDate is string && data.billDate.size() == 10 && data.billDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        (!('rawDate' in data) || (data.rawDate is string && data.rawDate.size() <= 20)) &&
        (!('checkInTime' in data) || (data.checkInTime is string && data.checkInTime.size() <= 20)) &&
        (!('checkOutTime' in data) || (data.checkOutTime is string && data.checkOutTime.size() <= 20)) &&
        data.paymentType is string && data.paymentType in ['cash', 'transfer', 'debt', 'split'] &&
        data.debtorName is string && data.debtorName.size() <= 120 &&
        data.debtStatus is string && data.debtStatus in ['none', 'unpaid', 'paid'] &&
        (!('settleDate' in data) || (data.settleDate is string && data.settleDate.size() <= 20)) &&
        (!('settledMethod' in data) || (data.settledMethod is string && data.settledMethod in ['cash', 'transfer'])) &&
        (!('paidCashAmount' in data) || (data.paidCashAmount is number && data.paidCashAmount >= 0)) &&
        (!('paidTransferAmount' in data) || (data.paidTransferAmount is number && data.paidTransferAmount >= 0)) &&
        (!('subtotalAmount' in data) || (data.subtotalAmount is number && data.subtotalAmount >= 0)) &&
        (!('discountAmount' in data) || (data.discountAmount is number && data.discountAmount >= 0)) &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.deductedAmount is number && data.deductedAmount >= 0 &&
        data.itemsSummary is string && data.itemsSummary.size() <= 1000 &&
        data.note is string && data.note.size() <= 500 &&
        data.status is string && data.status in ['active', 'locked'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBillItem(data) {
      return data.keys().hasAll([
          'ownerId', 'billId', 'billDate', 'productName', 'category',
          'quantity', 'returnedQuantity', 'unitPrice', 'subtotal', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'billId', 'billDate', 'productName', 'note', 'category',
          'quantity', 'returnedQuantity', 'unitPrice', 'subtotal', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billId is string && data.billId.size() >= 1 && data.billId.size() <= 128 && data.billId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billDate is string && data.billDate.size() == 10 && data.billDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 150 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.quantity is number && data.quantity > 0 &&
        data.returnedQuantity is number && data.returnedQuantity >= 0 && data.returnedQuantity <= data.quantity &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDeduction(data) {
      return data.keys().hasAll([
          'ownerId', 'billId', 'billCode', 'billDate', 'deductionDate',
          'productName', 'category', 'quantity', 'unitPrice', 'amount',
          'note', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'billId', 'billCode', 'billDate', 'deductionDate',
          'productName', 'category', 'quantity', 'unitPrice', 'amount',
          'note', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billId is string && data.billId.size() >= 1 && data.billId.size() <= 128 && data.billId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billCode is string && data.billCode.size() >= 1 && data.billCode.size() <= 64 &&
        data.billDate is string && data.billDate.size() == 10 && data.billDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.deductionDate is string && data.deductionDate.size() == 10 && data.deductionDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.quantity is number && data.quantity > 0 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.amount is number && data.amount >= 0 &&
        data.note is string && data.note.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReturn(data) {
      return data.keys().hasAll([
          'ownerId', 'billId', 'billCode', 'billDate', 'returnDate',
          'productName', 'category', 'quantity', 'unitPrice', 'amount',
          'note', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'billId', 'billCode', 'billDate', 'returnDate',
          'productName', 'category', 'quantity', 'unitPrice', 'amount',
          'note', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billId is string && data.billId.size() >= 1 && data.billId.size() <= 128 && data.billId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.billCode is string && data.billCode.size() >= 1 && data.billCode.size() <= 64 &&
        data.billDate is string && data.billDate.size() == 10 && data.billDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.returnDate is string && data.returnDate.size() == 10 && data.returnDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.quantity is number && data.quantity > 0 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.amount is number && data.amount >= 0 &&
        data.note is string && data.note.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceMeta(data) {
      return data.keys().hasAll([
          'ownerId', 'initialized', 'version', 'categoriesJson',
          'debtorsJson', 'rolePermissionsJson', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'initialized', 'version', 'categoriesJson',
          'debtorsJson', 'rolePermissionsJson', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        canWriteWorkspace(data.ownerId) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.initialized is bool &&
        data.version is number && data.version >= 0 &&
        data.categoriesJson is string && data.categoriesJson.size() <= 20000 &&
        data.debtorsJson is string && data.debtorsJson.size() <= 50000 &&
        data.rolePermissionsJson is string && data.rolePermissionsJson.size() <= 50000 &&
        data.updatedBy is string && data.updatedBy.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isVerified() && isValidId(adminId) && isValidAdminDoc(incoming()) &&
        incoming().createdAt == request.time && isAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(adminId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId &&
        isValidUser(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role != 'admin' || isAdmin());
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'updatedAt'])
          )
        );
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    match /workspace_meta/{workspaceId} {
      allow get: if isValidId(workspaceId) && canReadWorkspace(workspaceId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(workspaceId) && incoming().ownerId == workspaceId &&
        isValidWorkspaceMeta(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(workspaceId) && isValidWorkspaceMeta(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'initialized', 'version', 'categoriesJson',
          'debtorsJson', 'rolePermissionsJson', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if isValidId(workspaceId) && isAdmin();
    }

    match /staff_accounts/{accountId} {
      allow get: if isValidId(accountId) && canReadWorkspace(existing().ownerId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(accountId) && isValidStaffAccount(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(accountId) && isValidStaffAccount(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'password', 'displayName', 'info', 'role', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(accountId) && (resource == null || canWriteWorkspace(existing().ownerId));
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && canReadWorkspace(existing().ownerId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(productId) && isValidProduct(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isValidProduct(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['productName', 'category', 'unitPrice', 'unit', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['totalSold', 'totalReturned', 'totalRevenue', 'unitPrice', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'productName', 'category', 'unitPrice', 'unit',
            'totalSold', 'totalReturned', 'totalRevenue', 'updatedAt'
          ])
        );
      allow delete: if isValidId(productId) && (resource == null || canWriteWorkspace(existing().ownerId));
    }

    match /bills/{billId} {
      allow get: if isValidId(billId) && canReadWorkspace(existing().ownerId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(billId) && isValidBill(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(billId) && isValidBill(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['debtStatus', 'paymentType', 'note', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['deductedAmount', 'itemsSummary', 'note', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'billCode', 'billDate', 'rawDate', 'checkInTime', 'checkOutTime',
            'paymentType', 'debtorName', 'debtStatus', 'settleDate', 'settledMethod',
            'paidCashAmount', 'paidTransferAmount', 'subtotalAmount', 'discountAmount',
            'totalAmount', 'deductedAmount', 'itemsSummary', 'note', 'status', 'updatedAt'
          ])
        );
      allow delete: if isValidId(billId) && (resource == null || canWriteWorkspace(existing().ownerId));
    }

    match /bill_items/{itemId} {
      allow get: if isValidId(itemId) && canReadWorkspace(existing().ownerId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(itemId) && isValidBillItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isValidBillItem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().billId == existing().billId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['returnedQuantity', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'billDate', 'productName', 'note', 'category', 'quantity',
            'returnedQuantity', 'unitPrice', 'subtotal', 'updatedAt'
          ])
        );
      allow delete: if isValidId(itemId) && (resource == null || canWriteWorkspace(existing().ownerId));
    }

    match /deductions/{deductionId} {
      allow get: if isValidId(deductionId) && canReadWorkspace(existing().ownerId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(deductionId) && isValidDeduction(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(deductionId) && isValidDeduction(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().billId == existing().billId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'deductionDate', 'productName', 'category', 'quantity', 'unitPrice', 'amount', 'note', 'updatedAt'
        ]);
      allow delete: if isValidId(deductionId) && (resource == null || canWriteWorkspace(existing().ownerId));
    }

    match /returns/{returnId} {
      allow get: if isValidId(returnId) && canReadWorkspace(existing().ownerId);
      allow list: if canReadWorkspace(resource.data.ownerId);
      allow create: if isValidId(returnId) && isValidReturn(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(returnId) && isValidReturn(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().billId == existing().billId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canWriteWorkspace(existing().ownerId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'returnDate', 'quantity', 'unitPrice', 'amount', 'note', 'updatedAt'
        ]);
      allow delete: if isValidId(returnId) && (resource == null || canWriteWorkspace(existing().ownerId));
    }
  }
}
